{
  "name": "shoperzero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "npm run demo:provence",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "demo:agent": "tsx scripts/demo/agent.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres > src/infrastructure/database/types.gen.ts",
    "db:types:remote": "supabase gen types typescript --linked > src/infrastructure/database/types.gen.ts",
    "db:smoke": "node --env-file=.env.local --conditions=react-server --import tsx scripts/db/smoke.ts",
    "demo:before": "STORE_MODE=before PORT=4001 node demos/provence/server.mjs",
    "demo:after": "STORE_MODE=after PORT=4002 node demos/provence/server.mjs",
    "demo:stores": "node demos/provence/run-both.mjs",
    "test:browser": "node scripts/test.mjs browser",
    "demo:original": "node scripts/demo/serve-original.mjs",
    "demo:grok": "npm --prefix demos/prototypes/grok run dev -- --host 127.0.0.1 --port 4175",
    "demo:provence": "node scripts/demo/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@browserbasehq/sdk": "2.21.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1",
    "mcp-handler": "2.2.0",
    "next": "16.3.6",
    "p-queue": "9.3.3",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "3.0.1",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
